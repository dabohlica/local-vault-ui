# Optional. The app is configured in-app via the setup wizard (stored in data/config.json).
# These only provide DEFAULTS the wizard seeds from — copy to .env.local to override.

# Change only if Ollama runs on a non-default host/port:
OLLAMA_HOST=http://localhost:11434

# Default models offered in the wizard (you can pick others in the UI):
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llama3.2-vision   # optional, for image ingestion

# Optional two-model split (see MODEL-SELECTION.md). Both default to the chat model,
# so leave them unset for a single-model setup. Set them apart only with the RAM to
# swap/co-load two models (recommended at 48 GB+).
#   writer    = prose: chat answers, note merges
#   librarian = structure: curation/ingest/command/caretake proposals, OCR, taxonomy
# OLLAMA_WRITER_MODEL=gemma4:12b
# OLLAMA_LIBRARIAN_MODEL=qwen3-vl:8b

# Optional cross-encoder reranker (Ollama). Build it with scripts/install-models-16gb.sh —
# community uploads of Qwen3-Reranker lack the yes/no head it scores with.
# OLLAMA_RERANK_MODEL=qwen3-reranker:0.6b
# Characters of note excerpts per chat answer (prompt size = main latency lever on 16 GB).
# RETRIEVAL_BUDGET_CHARS=12000

# Models served by MLX instead of Ollama: name them "mlx:<hf-repo>" (see MODEL-SELECTION.md and
# scripts/install-models-16gb.sh). The MLX server must listen on loopback:
# MLX_HOST=http://127.0.0.1:8080
# OLLAMA_EMBED_NUM_CTX=2048           # embedder context; keeps its RAM small on 16 GB

# Network: which address the :lan scripts bind (default: Tailscale IP), and extra hostnames
# (besides loopback, IP literals and *.ts.net) the app accepts in the Host header.
# VAULT_BIND=0.0.0.0                  # exposes the app to your whole LAN — opt-in only
# VAULT_ALLOWED_HOSTS=macbook.local

# Optional: pre-seed the vault path so the wizard starts filled in.
# Colleagues normally set this in the wizard instead.
# VAULT_PATH=/Users/you/path/to/your/vault
